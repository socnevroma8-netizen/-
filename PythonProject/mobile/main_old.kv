#:import dp kivy.metrics.dp
#:import COLORS mobile.theme.colors.COLORS

<GradientButton@MDCard>:
    size_hint_y: None
    height: dp(92)
    radius: [28, 28, 28, 28]
    elevation: 2
    md_bg_color: 0.95, 0.95, 0.98, 1
    padding: dp(18)
    ripple_behavior: True

<SectionCard@MDCard>:
    radius: [28, 28, 28, 28]
    elevation: 1
    padding: dp(18)
    md_bg_color: 0.96, 0.96, 0.98, 1

<BackHeader@MDBoxLayout>:
    size_hint_y: None
    height: dp(90)
    padding: dp(12), dp(16), dp(12), dp(0)
    spacing: dp(12)

    canvas.before:
        Color:
            rgba: COLORS["header"]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [0, 0, 0, 0]

    MDIconButton:
        icon: "arrow-left"
        theme_icon_color: "Custom"
        icon_color: 1, 1, 1, 1
        pos_hint: {"center_y": .5}

    MDLabel:
        text: root.title if hasattr(root, "title") else ""
        halign: "center"
        bold: True
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        font_style: "H4"

    Widget:
        size_hint_x: None
        width: self.height